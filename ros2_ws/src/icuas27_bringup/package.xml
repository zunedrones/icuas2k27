<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>icuas27_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, course and parameter files and RViz configuration of the ICUAS 2027 race.</description>
  <maintainer email="zunedrones@example.com">zunedrones</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>icuas27_race</exec_depend>
  <exec_depend>icuas27_trajectory</exec_depend>
  <exec_depend>laser_uav_managers</exec_depend>
  <exec_depend>laser_uav_hw_api</exec_depend>
  <exec_depend>laser_uav_simulation</exec_depend>
  <exec_depend>laser_gazebo_resources</exec_depend>
  <exec_depend>laser_uav_estimators</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
